# Copy to `.env` next to the compose file and fill in. Never commit the filled copy.

# --- database ---------------------------------------------------------------
# Set when the roles were created by deploy/provision-instagram-db.sql. The ingester
# owns the schema and applies the migrations; the MCP role only ever reads it.
INSTAGRAM_INGEST_DB_PASSWORD=
INSTAGRAM_MCP_DB_PASSWORD=

# --- account ------------------------------------------------------------------
# A label for this account, stored on every row so a second account could be added
# later without merging corpora. Any short string; the handle is the obvious choice.
#
# The session itself is not configured here. It is a cookie jar in the database, seeded
# once from INSTAGRAM_COOKIES_FROM (see deploy/compose.yaml) and kept current from then
# on, because Instagram rotates cookies and a jar that forgets a rotation is logged out.
INSTAGRAM_ACCOUNT=

# --- optional ingester tuning (defaults shown) -------------------------------
# INSTAGRAM_POLL_INTERVAL=900               seconds between full passes
# INSTAGRAM_POLL_JITTER=0.2                 fraction of the interval added/subtracted at random
# INSTAGRAM_POLL_THREAD_BUDGET=20           threads opened per pass, newest activity first
# INSTAGRAM_SWEEP_WINDOW_DAYS=7             how far back a pass checks for edits and unsends
# INSTAGRAM_RATE_LIMIT_RPS=0.2              requests/second toward Instagram
# INSTAGRAM_RATE_LIMIT_BURST=3
# INSTAGRAM_BACKFILL_ENABLED=true           crawl history older than the first poll
# INSTAGRAM_BACKFILL_REQUEST_BUDGET=40      requests one backfill pass may spend
# INSTAGRAM_BACKFILL_DAILY_REQUESTS=400     and the whole UTC day, across restarts
# INSTAGRAM_AUTH_RETRY=21600                seconds to wait after a rejected session
# INSTAGRAM_LOG_LEVEL=INFO

# --- optional MCP tuning (defaults shown) ------------------------------------
# INSTAGRAM_MCP_LOG_LEVEL=INFO
